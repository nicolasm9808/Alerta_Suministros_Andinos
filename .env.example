## --- LLM (Google Gemini, plan gratuito: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Notificaciones por Telegram ---
# Token del bot creado con @BotFather
TELEGRAM_BOT_TOKEN=
# Chat o grupo que recibe las alertas (escríbele al bot y consulta
# https://api.telegram.org/bot<TOKEN>/getUpdates para ver el chat.id)
TELEGRAM_CHAT_ID=

# --- API (Ejercicio 2) ---
# Ruta del archivo SQLite; si no existe se crea desde sql/datos_prueba.sql
DATABASE_PATH=api/data/suministros.db
# URL con la que n8n llega a la API (en docker-compose: http://api:8000)
API_BASE_URL=http://localhost:8000

# --- n8n ---
N8N_PORT=5678
# Permite que los nodos lean API_BASE_URL, GEMINI_MODEL y TELEGRAM_CHAT_ID con $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
